cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.3-service.manaus2",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.3-service.manaus2.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.3-service.manaus2.xml"],
    relative_install_path: "hw",
    srcs: [
        "service.cpp",
        "BiometricsFingerprint.cpp",
        "BiometricsPerf.cpp",
    ],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.biometrics.fingerprint@2.1",
        "android.hardware.biometrics.fingerprint@2.2",
        "android.hardware.biometrics.fingerprint@2.3",
        "vendor.egistec.hardware.fingerprint@4.0",
        "android.hardware.power-V1-ndk",
        "pixel-power-ext-V1-ndk",
    ],
    header_libs: ["generated_kernel_headers"]
}
