android_app {
    name: "MotoActionsManaus",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },

    required: [
        "org.lineageos.settings.device.xml",
        "hidden-api-whitelist-org.lineageos.settings.device.xml",
    ],
}

prebuilt_etc {
    sub_dir: "permissions",
    name: "org.lineageos.settings.device.xml",
    filename: "org.lineageos.settings.device.xml",
    src: "org.lineageos.settings.device.xml",
    system_ext_specific: true,
}

prebuilt_etc {
    sub_dir: "sysconfig",
    name: "hidden-api-whitelist-org.lineageos.settings.device.xml",
    filename: "hidden-api-whitelist-org.lineageos.settings.device.xml",
    src: "hidden-api-whitelist-org.lineageos.settings.device.xml",
    system_ext_specific: true,
}
