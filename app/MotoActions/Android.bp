android_app {
    name: "MotoActionsManaus",
    overrides: ["MotoActions"],
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "org.lineageos.settings.resources",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },

    required: [
        "org.lineageos.settings.device.xml",
        "hidden-api-whitelist-org.lineageos.settings.device.xml",
    ],
}
