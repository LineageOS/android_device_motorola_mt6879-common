soong_config_module_type {
    name: "motorola_biometrics_fingerprint_defaults",
    module_type: "cc_defaults",
    config_namespace: "motorola_biometrics_fingerprint",
    bool_variables: [
        "impl_v2",
    ],
    properties: [
        "cppflags",
    ],
}

motorola_biometrics_fingerprint_defaults {
    name: "motorola_biometrics_fingerprint_defaults",

    soong_config_variables: {
        impl_v2: {
            cppflags: ["-DIMPL_V2"],
        },
    },
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.motorola",
    defaults: ["motorola_biometrics_fingerprint_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.motorola.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.motorola.xml"],
    srcs: [
        "CancellationSignal.cpp",
        "Fingerprint.cpp",
        "FingerprintConfig.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "libdl",
        "liblog",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.config",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
    ],
    static_libs: [
        "libandroid.hardware.biometrics.fingerprint.Props",
        "libudfpshandlerfactory",
    ],
    vendor: true,
    header_libs: ["motorolafingerprint_headers"],
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.Props",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}
